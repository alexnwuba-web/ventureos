<%- include('../partials/head') %>
<div class="wrap">
  <%- include('../partials/portalnav') %>
  <% if (notice === 'saved') { %><div class="notice ok" style="margin-top:16px">Saved.</div><% } %>
  <% if (notice === 'sent') { %><div class="notice ok" style="margin-top:16px">Sent. We have emailed you a confirmation and will write to you at each stage.</div><% } %>
  <% for (const m of upcoming) { %>
    <div class="notice <%= m.status === 'proposed' ? 'warn' : 'ok' %>" style="margin-top:16px"><b><%= m.title %>:</b> <%= P.whenLagos(m.starts_at) %> — <%= P.STATUS[m.status] %>. <a href="/my/a/<%= app.ref %>/meetings"><%= m.status === 'proposed' ? 'Reply' : 'Details' %></a></div>
  <% } %>
  <% if (counts.requests || counts.actions) { %><div class="notice warn" style="margin-top:16px">ScaleGate has asked for <%= [counts.requests ? counts.requests + ' document' + (counts.requests > 1 ? 's' : '') : '', counts.actions ? counts.actions + ' follow-up' + (counts.actions > 1 ? 's' : '') : ''].filter(Boolean).join(' and ') %>. <a href="/my/a/<%= app.ref %>/followups">See what is needed</a></div><% } %>
  <% if (onClock(app)) { %><div class="notice" style="margin-top:16px">We will give you a written answer by <b><%= date(answerDue(app.submitted_at)) %></b> — ten working days from when you sent it.</div><% } %>
  <% if (app.status === 'full_requested') { %><div class="notice warn" style="margin-top:16px"><b>Good news — we would like to proceed.</b> Please complete the full documentation: the parts marked <b>New</b> and the documents still required. Send it when everything is in.</div><% } %>
  <% if (app.status === 'draft') { %><div class="notice" style="margin-top:16px"><b>Part 1 of 2 — initial submission.</b> Tell us about the venture and what you are asking for, with your pitch deck and business plan. If we would like to proceed, we will invite you to Part 2, the full documentation (financial statements, tax returns, the business background questionnaire and the rest).</div><% } %>
  <% if (app.status === 'info_requested') { %><div class="notice warn" style="margin-top:16px">We need more information — see the message below. Update your answers or documents, then send the application back.</div><% } %>

  <% if (['declined'].includes(app.status)) { %><%- include('../partials/academy', { academyText: 'This is not the end of the road. OxiAcademy has courses and clinics to help you keep building — and you are welcome to apply to VentureOS again.' }) %><% } else if (app.status !== 'draft') { %><%- include('../partials/academy', { academyText: 'While we review, keep building: courses and clinics for founders, and support for programmes such as iDICE.' }) %><% } %>
  <div class="split" style="margin-top:20px">
    <div>
      <div class="card">
        <div class="row between"><h2 style="margin:0"><%= app.stage === 2 ? 'Part 2 — full documentation' : 'Part 1 — initial submission' %></h2><span class="small muted"><%= ready.percent %>% complete</span></div>
        <div class="bar" style="margin:12px 0 6px"><span style="width:<%= ready.percent %>%"></span></div>
        <ol class="steps">
          <% sections.forEach((s, i) => { const cls = s.required && s.done === s.required ? 'done' : (s.started ? 'part' : ''); %>
            <li class="<%= cls %>"><span class="n"><%= cls === 'done' ? '✓' : i + 1 %></span>
              <a href="/my/a/<%= app.ref %>/s/<%= s.key %>"><%= s.title %></a><% if (app.stage === 2 && s.partTwo) { %> <span class="badge amber">New</span><% } %>
              <span class="meta"><%= s.required ? `${s.done} of ${s.required} required` : 'Optional' %></span></li>
          <% }) %>
          <li class="<%= !ready.docsMissing.length ? 'done' : (docs.length ? 'part' : '') %>"><span class="n"><%= !ready.docsMissing.length ? '✓' : sections.length + 1 %></span>
            <a href="/my/a/<%= app.ref %>/documents">Documents</a><span class="meta"><%= docs.length %> uploaded<%= ready.docsMissing.length ? ` · ${ready.docsMissing.length} required still missing` : '' %></span></li>
        </ol>
        <% if (editable) { %>
          <p style="margin:18px 0 0"><a class="btn <%= ready.ready ? 'gold' : '' %>" href="/my/a/<%= app.ref %>/review"><%= app.stage === 2 ? 'Check and send the full documentation' : 'Check and send the initial submission' %></a></p>
        <% } %>
      </div>

      <div class="card" id="messages">
        <% const rTo = typeof replyTo !== 'undefined' ? replyTo : null; const waiting = messages.filter((m) => m.awaiting);
           const pick = messages.find((m) => m.id === rTo && !m.fromFounder) || waiting[waiting.length - 1] || null; %>
        <h2 style="margin-top:0">Messages</h2>
        <% if (typeof msgError !== 'undefined' && msgError) { %><div class="notice err"><%= msgError %></div><% } %>
        <% if (notice === 'message-sent') { %><div class="notice ok">Sent. Any files you attached are now with your application's documents.</div><% } %>
        <% if (waiting.length) { %><div class="notice warn">ScaleGate is waiting for your reply to <b><%= waiting.map((m) => m.ref).join(', ') %></b>.</div><% } %>
        <% if (!messages.length) { %><p class="muted">No messages yet. If you have a question about your application, write to us here.</p><% } %>
        <% for (const m of messages) { %>
          <div class="msg <%= m.fromFounder ? '' : 'staff' %>" id="m-<%= m.id %>">
            <div class="who"><b><%= m.ref || '' %></b> · <%= m.fromFounder ? 'You' : 'ScaleGate Africa' %> · <%= when(m.created_at) %>
              <% if (m.parent_ref) { %> · in reply to <a href="#m-<%= m.reply_to %>"><%= m.parent_ref %></a><% } %>
              <% if (m.awaiting) { %> <span class="badge amber">Awaiting your reply</span><% } else if (!m.fromFounder && m.replies.length) { %> <span class="badge green">Replied</span><% } %></div>
            <div class="answer"><%= m.body %></div>
            <% if (m.files.length) { %><div class="small" style="margin-top:6px">📎 <% m.files.forEach((f, i) => { %><%= i ? ' · ' : '' %><a href="/files/<%= f.id %>" target="_blank"><%= f.filename %></a><% }) %></div><% } %>
            <% if (!m.fromFounder && !['withdrawn'].includes(app.status)) { %><p class="small" style="margin:6px 0 0"><a href="?reply=<%= m.id %>#reply-form">Reply to <%= m.ref %></a></p><% } %>
          </div>
        <% } %>
        <% if (!['withdrawn'].includes(app.status)) { %>
        <form method="post" action="/my/a/<%= app.ref %>/message" enctype="multipart/form-data" id="reply-form" style="margin-top:14px">
          <% const ours = messages.filter((m) => !m.fromFounder); %>
          <% if (ours.length) { %>
            <label class="lbl" for="reply_to">Replying to</label>
            <select id="reply_to" name="reply_to" style="margin-bottom:10px">
              <option value="">A new message (not a reply)</option>
              <% for (const m of ours.slice().reverse()) { %><option value="<%= m.id %>" <%= pick && pick.id === m.id ? 'selected' : '' %>><%= m.ref %> — <%= m.body.length > 60 ? m.body.slice(0, 60) + '…' : m.body %><%= m.awaiting ? ' (awaiting your reply)' : '' %></option><% } %>
            </select>
          <% } %>
          <textarea name="body" placeholder="Write a message…" maxlength="4000"<%= rTo ? ' autofocus' : '' %>></textarea>
          <div class="field" style="margin:10px 0 0">
            <label class="lbl" for="msg-files">Attach files <span class="muted small">(optional — up to 5, 20 MB each)</span></label>
            <input id="msg-files" type="file" name="files" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.jpg,.jpeg,.png,.webp,.txt,.zip">
            <p class="help" style="margin-top:4px">Attached files are added to your application's documents, marked with this message's reference.</p>
          </div>
          <p style="margin:8px 0 0"><button class="btn small" type="submit">Send message</button></p>
        </form>
        <% } %>
      </div>
    </div>

    <aside>
      <div class="card">
        <h3>Applying for</h3>
        <% if (app.status === 'draft') { %>
          <form method="post" action="/my/a/<%= app.ref %>/kinds">
            <% for (const [k, v] of Object.entries(kinds)) { %>
              <label class="choice"><input type="checkbox" name="kinds[]" value="<%= k %>" <%= app.kinds.includes(k) ? 'checked' : '' %>><span><%= v.label %></span></label>
            <% } %>
            <button class="btn small ghost" type="submit">Update</button>
          </form>
        <% } else { %>
          <% for (const k of app.kinds) { %><div><%= kinds[k].label %></div><% } %>
        <% } %>
      </div>
      <div class="card small">
        <h3>Where it stands</h3>
        <table class="kv">
          <tr><td>Status</td><td><%= status(app.status).founder %></td></tr>
          <tr><td>Started</td><td><%= date(app.created_at) %></td></tr>
          <tr><td>Sent</td><td><%= date(app.submitted_at) %></td></tr>
          <% if (app.cohort_name) { %><tr><td>Cohort</td><td><%= app.cohort_name %></td></tr><% } %>
        </table>
        <% if (!status(app.status).final) { %>
          <form method="post" action="/my/a/<%= app.ref %>/withdraw" data-confirm="Withdraw this application? You cannot undo this." style="margin-top:12px">
            <button class="linkbtn small muted" type="submit">Withdraw application</button></form>
        <% } %>
      </div>
    </aside>
  </div>
</div>
<%- include('../partials/foot') %>
