<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · VentureOS</title>
  <meta name="description" content="VentureOS by ScaleGate Africa — the way into ScaleGate. Make. Grow. Create. Apply for ScaleGate's programmes, the VentureOS Center residency, equity, debt or grant funding.">
  <meta name="theme-color" content="#15120f">
  <script>document.documentElement.className += ' js';</script>
  <link rel="preload" href="/static/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/brand.css?v=<%= v %>">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= v %>">
  <link rel="icon" type="image/svg+xml" href="/static/img/ventureos-app-icon.svg">
  <script src="/static/js/brand.js?v=<%= v %>" defer></script>
  <% const LU = locals.config && locals.config.langUrl; if (LU && LU !== 'off') { %><script defer src="<%= LU %>/oxi-lang/lang.js" data-api="<%= LU %>" data-me="/oxi-lang/me"></script><% } %>
</head>
<body id="top">
<% const sgA = config.scalegate.africa, sgE = config.scalegate.europe; %>
<div class="sgbar">
  <div class="wrap">
    <span class="sgbar__lead">VentureOS is the front door of <b>ScaleGate</b></span>
    <span class="sgbar__links">
      <a href="<%= sgA.url %>" target="_blank" rel="noopener"><span class="sgbar__k">In Africa</span> <%= sgA.host %> <span aria-hidden="true">↗</span></a>
      <a href="<%= sgE.url %>" target="_blank" rel="noopener"><span class="sgbar__k">In Europe</span> <%= sgE.host %> <span aria-hidden="true">↗</span></a>
    </span>
  </div>
</div>
<header class="top">
  <div class="wrap">
    <div class="brand"><a class="brand__home" href="/" aria-label="VentureOS home"><img class="mark" src="/static/img/ventureos-mark-ink.svg" alt=""><b>Venture<i>OS</i></b></a><a class="brand__by" href="<%= sgA.url %>" target="_blank" rel="noopener">by ScaleGate Africa</a></div>
    <nav>
      <span data-oxi-lang></span>
      <% if (person) { %>
        <% if (staff) { %>
          <a href="/staff" class="<%= path.startsWith('/staff/a') || path === '/staff' ? 'on' : '' %>">Applications</a>
          <% if (['admin', 'officer', 'committee'].includes(staff)) { %><a href="/staff/meetings" class="<%= path.startsWith('/staff/meetings') ? 'on' : '' %>">Meetings</a><a href="/staff/events" class="<%= path.startsWith('/staff/events') ? 'on' : '' %>">Events</a><a href="/staff/cohorts" class="<%= path.startsWith('/staff/cohorts') ? 'on' : '' %>">Cohorts</a><% } %>
          <% if (['admin', 'finance', 'committee'].includes(staff)) { %><a href="/staff/tab" class="<%= path.startsWith('/staff/tab') ? 'on' : '' %>">Innovator tab</a><% } %>
          <% if (['admin', 'officer'].includes(staff)) { %><a href="/staff/partners" class="<%= path.startsWith('/staff/partners') ? 'on' : '' %>">Partners</a><% } %><% if (staff === 'admin') { %><a href="/staff/site" class="<%= path.startsWith('/staff/site') ? 'on' : '' %>">Front page</a><a href="/staff/people" class="<%= path.startsWith('/staff/people') ? 'on' : '' %>">Staff</a><% } %>
        <% } %>
        <a href="/my" class="<%= path.startsWith('/my') ? 'on' : '' %>"><%= staff ? 'My applications' : 'Your applications' %></a>
        <form method="post" action="/signout" style="display:inline"><button type="submit">Sign out</button></form>
      <% } else { %>
        <a href="/#scalegate">Programmes</a>
        <a href="/events" class="<%= path.startsWith('/events') ? 'on' : '' %>">Events</a>
        <a href="/#cohorts">Center</a>
        <a href="/#projects">Interests</a>
        <a href="/partner" class="<%= path.startsWith('/partner') ? 'on' : '' %>">Partner with us</a>
        <a href="/signin" class="<%= path.startsWith('/signin') ? 'on' : '' %>">Sign in</a>
        <a href="/#apply" class="cta">Apply</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="<%= typeof flush !== 'undefined' && flush ? 'flush' : '' %>">
