<% let bal = 0; %>
<div class="card" style="padding:0">
<table class="list">
  <thead><tr><th>Date</th><th>For</th><th>Period</th><th>Note</th><th class="right">Amount</th><th class="right">Balance</th></tr></thead>
  <tbody>
  <% if (!entries.length) { %><tr><td colspan="6" class="muted">Nothing on the tab yet.</td></tr><% } %>
  <% for (const e of entries) { bal += Number(e.amount); %>
    <tr><td class="nowrap small"><%= date(e.created_at) %></td><td><%= e.kind[0].toUpperCase() + e.kind.slice(1) %></td><td class="small"><%= e.period || '' %></td><td class="small"><%= e.memo || '' %></td>
      <td class="right nowrap" style="color:<%= e.amount < 0 ? 'var(--green)' : 'inherit' %>"><%= e.currency %> <%= full(e.amount) %></td><td class="right nowrap"><b><%= full(bal) %></b></td></tr>
  <% } %>
  </tbody>
</table>
</div>
<p class="right">Balance owed: <b><%= entries[0] ? entries[0].currency : 'NGN' %> <%= full(bal) %></b></p>
