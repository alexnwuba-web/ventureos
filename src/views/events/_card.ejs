<%
  // One event as a card. In: e, E, P, person.
  const lag = new Date(new Date(e.starts_at).getTime() + 3600e3);
%>
<div class="card announce event-card">
  <div class="row" style="align-items:flex-start;flex-wrap:nowrap">
    <div class="datebox"><b><%= lag.getUTCDate() %></b><span><%= lag.toLocaleString('en-GB', { month: 'short', timeZone: 'UTC' }) %></span></div>
    <div style="flex:1">
      <span class="badge <%= e.kind === 'investment' ? 'kind' : e.kind === 'demo_day' ? 'violet' : 'blue' %>"><%= E.KINDS[e.kind] %></span>
      <h3 style="margin:6px 0 2px"><a href="/events/<%= e.id %>" style="text-decoration:none"><%= e.title %></a></h3>
      <div class="small muted"><%= P.whenLagos(e.starts_at) %><%= e.venue ? ' · ' + e.venue : (e.online_link ? ' · Online' : '') %></div>
      <% if (e.summary) { %><p class="small" style="margin:8px 0 10px"><%= e.summary.length > 220 ? e.summary.slice(0, 217) + '…' : e.summary %></p><% } %>
      <div class="row">
        <% if (E.registrationOpen(e)) { %><a class="btn small" href="/events/<%= e.id %>#register">Register to attend</a><% } else if (E.full(e)) { %><span class="badge red">Full</span><% } %>
        <% if (E.pitchOpen(e)) { %><a class="btn small gold" href="/events/<%= e.id %>/present">Submit to present</a><% } %>
      </div>
    </div>
  </div>
</div>
