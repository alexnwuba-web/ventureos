<%- include('../partials/head') %>
<%
  const cohortForm = (c) => `
    <div class="grid g3">
      <div class="field"><label class="lbl">Name</label><input type="text" name="name" value="${esc(c.name || '')}" placeholder="Cohort 0" required></div>
      <div class="field"><label class="lbl">Campus</label><select name="campus_id"><option value="">—</option>${campuses.map((k) => `<option value="${k.id}" ${c.campus_id === k.id ? 'selected' : ''}>${esc(k.name)}</option>`).join('')}</select></div>
      <div class="field"><label class="lbl">Status</label><select name="status">${['planned','open','closed','running','completed'].map((s) => `<option ${c.status === s ? 'selected' : ''}>${s}</option>`).join('')}</select></div>
      <div class="field"><label class="lbl">Applications open</label><input type="date" name="opens_on" value="${c.opens_on || ''}"></div>
      <div class="field"><label class="lbl">Applications close</label><input type="date" name="closes_on" value="${c.closes_on || ''}"></div>
      <div class="field"><label class="lbl">Starts</label><input type="date" name="starts_on" value="${c.starts_on || ''}"></div>
      <div class="field"><label class="lbl">Timing, if no exact date</label><input type="text" name="timing" value="${esc(c.timing || '')}" placeholder="Mid-2027"></div>
      <div class="field"><label class="lbl">Places</label><input type="number" name="size_target" min="1" value="${c.size_target || ''}"></div>
    </div>
    <div class="field"><label class="lbl">Announcement on the front page</label><textarea name="announcement">${esc(c.announcement || '')}</textarea></div>
    <label class="choice"><input type="checkbox" name="public" value="yes" ${c.public ? 'checked' : ''}> Announce on the front page (while planned, open or running)</label>`;
%>
<div class="wrap">
  <h1>Cohorts</h1>
  <p class="muted">Cohort 0: 8–10 founders, mid-2027, mainly Nigerian and West African. Full cohorts: 12–20 resident innovators, 6–12 months, balanced across Make, Grow and Create. Public cohorts are announced on the front page.</p>
  <% for (const c of cohorts) { %>
    <div class="card">
      <div class="row between"><h3 style="margin:0"><%= c.name %> <% if (c.public) { %><span class="badge green">On the front page</span><% } %></h3>
        <span class="small muted"><%= c.apps %> applications · <%= c.accepted %> accepted<%= c.campus_name ? ' · ' + c.campus_name : '' %></span></div>
      <% if (staff === 'admin') { %>
        <details style="margin-top:10px"><summary class="small" style="cursor:pointer">Edit</summary>
          <form method="post" action="/staff/cohorts/<%= c.id %>" style="margin-top:12px"><%- cohortForm(c) %><p><button class="btn small" type="submit">Save</button></p></form></details>
      <% } else { %><p class="small"><%= c.announcement || '' %></p><% } %>
    </div>
  <% } %>
  <% if (staff === 'admin') { %>
    <form class="card" method="post" action="/staff/cohorts"><h3 style="margin-top:0">New cohort</h3><%- cohortForm({ status: 'planned' }) %><p><button class="btn" type="submit">Create</button></p></form>
  <% } %>
</div>
<%- include('../partials/foot') %>
